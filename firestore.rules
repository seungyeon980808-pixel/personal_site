rules_version = '2';

// =========================================================================
// Firestore 보안 규칙 — personal_site
//
//  배포 방법 (둘 중 하나):
//   A) Firebase 콘솔 → Firestore Database → 규칙 탭 → 아래 내용 붙여넣기 → 게시
//   B) firebase CLI:  firebase deploy --only firestore:rules
//      (firebase.json 에 "firestore": { "rules": "firestore.rules" } 추가 필요)
//
//  핵심:
//   - personal-site/*  : 누구나 읽기, 관리자만 쓰기 (사이트 내용)
//   - comments/*       : 누구나 읽기, 누구나 "검증된" 후기 작성, 관리자만 삭제
//   - 그 외 전부 차단
// =========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'seungyeon980808@gmail.com'
          && request.auth.token.email_verified == true;
    }

    // ---- 사이트 내용 (메인 허브 + 프로젝트 상세) ----
    match /private-workspaces/owner {
      allow read: if isAdmin() && request.auth.token.email_verified == true;
      allow create, update: if isAdmin() && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is string
        && request.resource.data.items.size() <= 500000;
      allow delete: if isAdmin() && request.auth.token.email_verified == true;
    }
    match /personal-site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- 후기/댓글 ----
    match /comments/{commentId} {
      allow read: if true;

      // An anonymous identity must atomically advance its server-enforced cooldown.
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/comment-cooldowns/$(request.auth.uid)).data.commentId == commentId
        && getAfter(/databases/$(database)/documents/comment-cooldowns/$(request.auth.uid)).data.lastCreatedAt == request.time
        && request.resource.data.keys().hasOnly(['project', 'name', 'text', 'createdAt', 'authorId'])
        && request.resource.data.project is string
        && request.resource.data.project.size() > 0
        && request.resource.data.project.size() <= 40
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;

      // 관리자만 답글 추가/수정 가능 (원본 이름·내용·시각은 변경 불가)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'repliedAt'])
        && request.resource.data.reply is string
        && request.resource.data.reply.size() <= 500
        && request.resource.data.repliedAt == request.time
        && request.resource.data.project == resource.data.project
        && request.resource.data.name == resource.data.name
        && request.resource.data.text == resource.data.text
        && request.resource.data.createdAt == resource.data.createdAt;

      // 삭제는 관리자만 (스팸/부적절 후기 정리)
      allow delete: if isAdmin();
    }

    match /comment-cooldowns/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['commentId', 'lastCreatedAt'])
        && request.resource.data.commentId is string
        && request.resource.data.lastCreatedAt == request.time
        && (!exists(/databases/$(database)/documents/comment-cooldowns/$(uid))
          || request.time >= resource.data.lastCreatedAt + duration.value(60, 's'))
        && !exists(/databases/$(database)/documents/comments/$(request.resource.data.commentId))
        && getAfter(/databases/$(database)/documents/comments/$(request.resource.data.commentId)).data.authorId == uid
        && getAfter(/databases/$(database)/documents/comments/$(request.resource.data.commentId)).data.createdAt == request.time;
    }

    // ---- 그 외 전부 차단 ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
